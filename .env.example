# Copy to .env and fill in. .env is gitignored; this template is not.
#
#     cp .env.example .env
#
# Precedence, highest first:
#     environment  >  .env  >  configs/base.yaml  >  field default
#
# So everything below is optional except PRAYER_DATA_URL, and only because
# nothing can be built without it. The values shown are the current effective
# defaults — uncomment a line only to change it.
#
# configs/base.yaml stays the readable description of how the service behaves;
# .env is for per-machine overrides and the one secret.


# ── Required to build the datasets ───────────────────────────────────────────
# Direct-download link to a .zip (or .tar.gz) of data/input/, containing the
# folders parks2021/, lockyer1959/ and watters1883/. The source books are
# copyrighted and are not in this repository, so `make fetch` needs this and
# `make setup` cannot run without it.
#
# The link must need no credentials. It must also serve the file itself
# rather than a download page — check with:
#     curl -fsSL "$PRAYER_DATA_URL" | head -c 4 | xxd     # expect "PK.." or gzip
PRAYER_DATA_URL=


# ── Serving ──────────────────────────────────────────────────────────────────
#PRAYER_HOST=127.0.0.1
#PRAYER_PORT=8000
# Set PRAYER_RELOAD to any non-empty value for auto-reload while developing.
#PRAYER_RELOAD=
# PORT (no prefix) is injected by the host platform — Render, Cloud Run, Heroku
# — and takes priority over PRAYER_PORT, because the platform owns the routing.
# Do not set it locally.
#PORT=


# ── Layout ───────────────────────────────────────────────────────────────────
# Absolute path to the repository root. Everything under data/ resolves from
# it. The container sets PRAYER_ROOT=/app; you should not need it locally.
#PRAYER_ROOT=

# Individual directories, all derived from PRAYER_ROOT. Override only to point
# at data built somewhere else.
#PRAYER_DATASET_DIR=data/build/datasets/sources/parks2021
#PRAYER_TEXT_DIR=data/build/text
#PRAYER_INDEX_DIR=data/build/index
#PRAYER_POLICY_DIR=policy
#PRAYER_PHRASES_DIR=policy/phrases
#PRAYER_EMBEDDING_MODEL_DIR=data/vendor/models/bge-small-en-v1.5


# ── Request defaults (used when a request does not say) ──────────────────────
#PRAYER_RETRIEVER=bm25              # bm25 | dense | hybrid
#PRAYER_COMPOSER=deterministic
#PRAYER_TRANSLATION=WEB
#PRAYER_K=3


# ── Retrieval tuning ─────────────────────────────────────────────────────────
# Below this score the service abstains rather than returning the nearest
# generic psalm. Deliberately low until Tier 3 evidence exists (M8).
#PRAYER_ABSTAIN_THRESHOLD=0.08
# 43 of 224 records are Psalms and the most thematically generic. This is the
# diversification knob; 0 until it has been measured rather than guessed.
#PRAYER_PSALM_PENALTY=0.0
#PRAYER_CANDIDATE_POOL=25
# Query-side ONNX threads. Lower it to 1 on a small instance: more threads cost
# memory and a fractional-CPU host cannot use them anyway.
#PRAYER_EMBEDDING_THREADS=4


# ── Composition ──────────────────────────────────────────────────────────────
#PRAYER_MAX_PASSAGE_VERSES_INLINE=20
#PRAYER_EXCERPT_VERSES=8
#PRAYER_COMPOSE_TIMEOUT_S=8.0
# The free composer generates without structural constraints. A small local
# model fabricates confidently, and the verifier catches quote and citation
# errors but not a plausible-sounding false claim. Off until that is measured.
#PRAYER_ENABLE_FREE_COMPOSER=false


# ── Local model (M5+, not yet in use) ────────────────────────────────────────
# No hosted LLM is ever called at request time; the runtime is fully offline.
#PRAYER_LLM_BACKEND=null
#PRAYER_LLM_MODEL_PATH=
#PRAYER_LLM_MAX_TOKENS=512
#PRAYER_LLM_TIMEOUT_S=6.0


# ── Ops ──────────────────────────────────────────────────────────────────────
# Situations are sensitive — what someone types here is often the worst thing
# happening in their life. Off by default; hashes are logged instead.
#PRAYER_LOG_SITUATIONS=false
#PRAYER_RATE_LIMIT_PER_MINUTE=60


# ── Third party ──────────────────────────────────────────────────────────────
#HF_HUB_DISABLE_TELEMETRY=1
